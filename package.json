{
  "name": "dsh-qq-companion",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Configurable QQ companion runtime and management for DeepSeek Harness",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./presets/*": "./presets/*"
  },
  "files": [
    "src",
    "lib",
    "presets",
    "report-templates",
    "report-renderer.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/cache-report.md",
    "docs/migration.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^4.3.2",
    "zod": "^4.4.3",
    "ws": "^8.18.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-0",
    "@deepseek-ai/dsh-tools": "^0.2.1-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-scope": "^0.2.1-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swlt-silica/dsh-qq-companion.git"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "puppeteer-core": "25.16.0"
  }
}
